msgstr "Välj den här datorn för att spela upptäcktslåtar och mixar."

#: src/ui/discovery.rs:258 src/ui/discovery.rs:655
msgid ""
"Demo discoveries. Feedback, recommendations and cloud requests are disabled."
msgstr ""
"Demoupptäckter. Feedback, rekommendationer och molnförfrågningar är "
"avstängda."

#: src/ui/discovery.rs:263 src/ui/discovery.rs:506
msgid "Opening your personal discovery workspace…"
msgstr "Öppnar din personliga upptäcktsvy…"

#: src/ui/discovery.rs:268
msgid "Sign in to Spotify to find new picks."
msgstr "Logga in på Spotify för att hitta nya förslag."

#: src/ui/discovery.rs:281
msgid "More discovery options"
msgstr "Fler sätt att upptäcka musik"

#: src/ui/discovery.rs:300
msgid "Save this mix"
msgstr "Spara den här mixen"

#: src/ui/discovery.rs:306
msgid "Syncing…"
msgstr "Synkar…"

#: src/ui/discovery.rs:308
msgid "Sync my devices"
msgstr "Synka mina enheter"

#: src/ui/discovery.rs:324
msgid "Tune taste"
msgstr "Justera musiksmak"

#: src/ui/discovery.rs:330
msgid "Hide AI history"
msgstr "Dölj AI-historik"

#: src/ui/discovery.rs:332
msgid "Show AI history"
msgstr "Visa AI-historik"

#: src/ui/discovery.rs:339
msgid "Turn off automatic picks"
msgstr "Stäng av automatiska förslag"

#: src/ui/discovery.rs:341
msgid "Turn on automatic picks"
msgstr "Slå på automatiska förslag"

#: src/ui/discovery.rs:356
msgid "Familiar"
msgstr "Välbekant"

#: src/ui/discovery.rs:357
msgid "Stay close to what you already love"
msgstr "Håll dig nära det du redan älskar"

#: src/ui/discovery.rs:361
msgid "Balanced"
msgstr "Balanserat"

#: src/ui/discovery.rs:362
msgid "Mix favourites with new finds"
msgstr "Blanda favoriter med nya fynd"

#: src/ui/discovery.rs:366
msgid "Adventurous"
msgstr "Äventyrligt"

#: src/ui/discovery.rs:367
msgid "Reach further from your usual music"
msgstr "Utforska musik längre från det du brukar lyssna på"

#: src/ui/discovery.rs:400
msgid "Tell Spotiurge what you like"
msgstr "Berätta för Spotiurge vad du gillar"

#: src/ui/discovery.rs:402
msgid "Your taste"
msgstr "Din musiksmak"

#: src/ui/discovery.rs:420
msgid "Warm jazz, spacious electronics, a few surprises…"
msgstr "Varm jazz, luftig elektronisk musik, några överraskningar…"

#: src/ui/discovery.rs:441
msgid "Save taste"
msgstr "Spara smak"

#: src/ui/discovery.rs:466
#, rust-format
msgid ""
"This computer is not paired with your private cloud. Quit Spotiurge, set "
"{variable} in its launch environment and open it again."
msgstr ""
"Den här datorn är inte parkopplad med ditt privata moln. Avsluta Spotiurge, "
"ange {variable} i dess startmiljö och öppna appen igen."

#: src/ui/discovery.rs:471
msgid "Your picks are already being prepared. Try again in a moment."
msgstr "Dina förslag håller redan på att tas fram. Försök igen om en stund."

#: src/ui/discovery.rs:476
msgid "The AI is rate limited. Your picks are kept; try again later."
msgstr ""
"AI:n har nått sin anropsgräns. Dina förslag finns kvar. Försök igen senare."

#: src/ui/discovery.rs:481
msgid "Recommendations are unavailable right now. Your picks are kept."
msgstr ""
"Rekommendationer är inte tillgängliga just nu. Dina förslag finns kvar."

#: src/ui/discovery.rs:486
msgid "The AI sent an answer Spotiurge could not use. Your picks are kept."
msgstr ""
"AI:n skickade ett svar som Spotiurge inte kunde använda. Dina förslag finns "
"kvar."

#: src/ui/discovery.rs:537
msgid "No picks yet. Refresh to find music for your taste."
msgstr "Inga förslag ännu. Uppdatera för att hitta musik som passar din smak."

#: src/ui/discovery.rs:546
#, rust-format
msgid "{count} ready to play"
msgid_plural "{count} ready to play"
msgstr[0] "{count} redo att spelas"
msgstr[1] "{count} redo att spelas"

#: src/ui/discovery.rs:557
#, rust-format
msgid "{count} not found on Spotify"
msgid_plural "{count} not found on Spotify"
msgstr[0] "{count} hittades inte på Spotify"
msgstr[1] "{count} hittades inte på Spotify"

#: src/ui/discovery.rs:569
#, rust-format
msgid "{count} not checked yet"
msgid_plural "{count} not checked yet"
msgstr[0] "{count} har inte kontrollerats ännu"
msgstr[1] "{count} har inte kontrollerats ännu"

#: src/ui/discovery.rs:581
msgid "Spotify took too long to answer."
msgstr "Spotify tog för lång tid på sig att svara."

#: src/ui/discovery.rs:584
msgid "Spotify asked Spotiurge to slow down."
msgstr "Spotify bad Spotiurge att sakta ner."

#: src/ui/discovery.rs:588
msgid "Spotiurge has used its Spotify search allowance for now."
msgstr "Spotiurge har nått sin sökgräns på Spotify för tillfället."

#: src/ui/discovery.rs:591
msgid "Spotify search is unavailable right now."
msgstr "Det går inte att söka på Spotify just nu."

#: src/ui/discovery.rs:594
msgid "Sign in to Spotify to check the rest."
msgstr "Logga in på Spotify för att kontrollera resten."

#: src/ui/discovery.rs:699
msgid "Spotify asked to wait. Retry in a moment."
msgstr "Spotify bad oss vänta. Försök igen om en stund."

#: src/ui/discovery.rs:709
msgid "Check again"
msgstr "Kontrollera igen"

#: src/ui/discovery.rs:745
msgid "More like this"
msgstr "Mer som det här"

#: src/ui/discovery.rs:746
msgid "Less like this"
msgstr "Mindre som det här"

#. Translators: {count} is a number of AI suggestions that cannot play.
#: src/ui/discovery.rs:931
#, rust-format
msgid "Couldn't play ({count})"
msgstr "Kunde inte spela ({count})"

#: src/ui/discovery.rs:953
msgid "Not checked on Spotify yet"
msgstr "Inte kontrollerat på Spotify ännu"

#: src/ui/discovery.rs:954
msgid "Not found on Spotify"
msgstr "Hittades inte på Spotify"

#: src/ui/discovery.rs:1049
msgid "Your saved mixes"
msgstr "Dina sparade mixar"

#: src/ui/discovery.rs:1062
msgid "Play mix"
msgstr "Spela mix"

#: src/ui/discovery.rs:1083
msgid "Remove mix"
msgstr "Ta bort mix"

#: src/ui/discovery.rs:1121
msgid "Your AI history"
msgstr "Din AI-historik"

#: src/ui/discovery.rs:1126
msgid "No AI requests yet."
msgstr "Inga AI-anrop ännu."

msgstr "Berätta för Spotiurge vad du gillar"

#: src/ui/discovery.rs:392
msgid "Your taste"
msgstr "Din musiksmak"

#: src/ui/discovery.rs:404
msgid "Warm jazz, spacious electronics, a few surprises…"
msgstr "Varm jazz, luftig elektronisk musik, några överraskningar…"

#: src/ui/discovery.rs:427
msgid "Save taste"
msgstr "Spara smak"

#: src/ui/discovery.rs:452
#, rust-format
msgid ""
"This computer is not paired with your private cloud. Quit Spotiurge, set "
"{variable} in its launch environment and open it again."
msgstr ""
"Den här datorn är inte parkopplad med ditt privata moln. Avsluta Spotiurge, "
"ange {variable} i dess startmiljö och öppna appen igen."

#: src/ui/discovery.rs:457
msgid "Your picks are already being prepared. Try again in a moment."
msgstr "Dina förslag håller redan på att tas fram. Försök igen om en stund."

#: src/ui/discovery.rs:462
msgid "The AI is rate limited. Your picks are kept; try again later."
msgstr ""
"AI:n har nått sin anropsgräns. Dina förslag finns kvar. Försök igen senare."

#: src/ui/discovery.rs:467
msgid "Recommendations are unavailable right now. Your picks are kept."
msgstr ""
"Rekommendationer är inte tillgängliga just nu. Dina förslag finns kvar."

#: src/ui/discovery.rs:472
msgid "The AI sent an answer Spotiurge could not use. Your picks are kept."
msgstr ""
"AI:n skickade ett svar som Spotiurge inte kunde använda. Dina förslag finns "
"kvar."

#: src/ui/discovery.rs:504
msgid "No picks yet. Refresh to find music for your taste."
msgstr "Inga förslag ännu. Uppdatera för att hitta musik som passar din smak."

#: src/ui/discovery.rs:513
#, rust-format
msgid "{count} ready to play"
msgid_plural "{count} ready to play"
msgstr[0] "{count} redo att spelas"
msgstr[1] "{count} redo att spelas"

#: src/ui/discovery.rs:524
#, rust-format
msgid "{count} not found on Spotify"
msgid_plural "{count} not found on Spotify"
msgstr[0] "{count} hittades inte på Spotify"
msgstr[1] "{count} hittades inte på Spotify"

#: src/ui/discovery.rs:536
#, rust-format
msgid "{count} not checked yet"
msgid_plural "{count} not checked yet"
msgstr[0] "{count} har inte kontrollerats ännu"
msgstr[1] "{count} har inte kontrollerats ännu"

#: src/ui/discovery.rs:548
msgid "Spotify took too long to answer."
msgstr "Spotify tog för lång tid på sig att svara."

#: src/ui/discovery.rs:551
msgid "Spotify asked Spotiurge to slow down."
msgstr "Spotify bad Spotiurge att sakta ner."

#: src/ui/discovery.rs:555
msgid "Spotiurge has used its Spotify search allowance for now."
msgstr "Spotiurge har nått sin sökgräns på Spotify för tillfället."

#: src/ui/discovery.rs:558
msgid "Spotify search is unavailable right now."
msgstr "Det går inte att söka på Spotify just nu."

#: src/ui/discovery.rs:561
msgid "Sign in to Spotify to check the rest."
msgstr "Logga in på Spotify för att kontrollera resten."

#: src/ui/discovery.rs:657
msgid "Spotify asked to wait. Retry in a moment."
msgstr "Spotify bad oss vänta. Försök igen om en stund."

#: src/ui/discovery.rs:667
msgid "Check again"
msgstr "Kontrollera igen"

#: src/ui/discovery.rs:703
msgid "More like this"
msgstr "Mer som det här"

#: src/ui/discovery.rs:704
msgid "Less like this"
msgstr "Mindre som det här"

